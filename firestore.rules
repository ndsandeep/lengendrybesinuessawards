rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validCategory(category) {
      return category in [
        "Business Excellence",
        "Entrepreneurial Leadership",
        "Innovation & Technology",
        "Women Leadership",
        "Finance & Investment",
        "Healthcare Excellence",
        "Education & Skill Development",
        "Real Estate & Infrastructure",
        "Manufacturing Excellence",
        "Retail & Consumer Business",
        "Media & Communications",
        "Social Impact",
        "Sustainability & Environment",
        "Arts, Culture & Heritage",
        "Community Leadership"
      ];
    }

    function validRegistration(data) {
      return data.keys().hasOnly([
          "name",
          "email",
          "phone",
          "bio",
          "category",
          "amount",
          "currency",
          "upiVpa",
          "upiName",
          "status",
          "paymentReference",
          "paymentSubmittedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "name",
          "email",
          "phone",
          "bio",
          "category",
          "amount",
          "currency",
          "upiVpa",
          "upiName",
          "status",
          "paymentReference",
          "paymentSubmittedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() <= 200
        && data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")
        && data.phone is string
        && data.phone.matches("^[6-9][0-9]{9}$")
        && data.bio is string
        && data.bio.size() >= 20
        && data.bio.size() <= 1500
        && data.category is string
        && validCategory(data.category)
        && data.amount == 249900
        && data.currency == "INR"
        && data.upiVpa is string
        && data.upiVpa == "7675817372@barodampay"
        && data.upiVpa.matches("^[A-Za-z0-9._-]{2,256}@[A-Za-z0-9.-]{2,64}$")
        && data.upiName is string
        && data.upiName.size() >= 2
        && data.upiName.size() <= 100
        && data.status == "awaiting_payment"
        && data.paymentReference == null
        && data.paymentSubmittedAt == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validPaymentReferenceUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == "awaiting_payment"
        && request.resource.data.status == "payment_submitted"
        && changedKeys.hasOnly([
          "status",
          "paymentReference",
          "paymentSubmittedAt",
          "updatedAt"
        ])
        && changedKeys.hasAll([
          "status",
          "paymentReference",
          "paymentSubmittedAt",
          "updatedAt"
        ])
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 6
        && request.resource.data.paymentReference.size() <= 100
        && request.resource.data.paymentSubmittedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /registrations/{registrationId} {
      allow read, delete: if false;
      allow create: if validRegistration(request.resource.data);
      allow update: if validPaymentReferenceUpdate();
    }
  }
}
